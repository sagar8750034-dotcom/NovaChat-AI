# Copy this file to .env and fill in your real values:
#   copy .env.example .env
#
# Get a Gemini key from Google AI Studio: https://aistudio.google.com/apikey
# Get a Neon connection string from: https://console.neon.tech

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Neon PostgreSQL (use the pooled URI if Neon provides one)
# Example: postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=your_neon_database_url

# Flask session signing key. Generate a long random string and keep it private.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string
# Optional: set to true if the app is served only over HTTPS
# SESSION_COOKIE_SECURE=false
# Cross-origin Netlify → Render: set FRONTEND_ORIGIN to your Netlify site URL
# (https://YOUR-SITE.netlify.app). Session cookies then default to SameSite=None; Secure.
# FRONTEND_ORIGIN=
# CORS_ORIGINS=https://YOUR-SITE.netlify.app
# SESSION_COOKIE_SAMESITE=None
# SESSION_COOKIE_SECURE=true

# Google OAuth (Web application client). Fill these in locally; never commit real values.
# Authorized redirect URI must match Google Cloud Console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5002/auth/google/callback

# Neural TTS (ElevenLabs). Keep the real key in .env only — never in frontend code.
TTS_API_KEY=your_tts_api_key_here
# Optional: override the default adult male voice (Daniel)
# TTS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# TTS_MODEL=eleven_multilingual_v2
